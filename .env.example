# Zkopíruj jako .env (na serveru) a vyplň. Tento soubor NIKDY necommituj ani neposílej do chatu.

# Trading 212 – demo účet (Practice)
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Trading 212 – ostrý účet (vyplň až po testování na demu)
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# Telegram (reporty a ovládání z mobilu)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Varianta strategie: config.yaml (základní) nebo config-aggressive.yaml (vysoké riziko)
BOT_CONFIG=config.yaml
